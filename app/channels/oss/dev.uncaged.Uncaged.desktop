[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Uncaged
GenericName=TerminalEmulator

Exec=warp-terminal-oss %U
StartupWMClass=dev.uncaged.Uncaged

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.uncaged.Uncaged

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for uncaged:// and (pre-rename) uncagedoss:// URLs.
MimeType=x-scheme-handler/uncaged;x-scheme-handler/uncagedoss;
