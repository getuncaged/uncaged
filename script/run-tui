#!/bin/bash
#
# Run a local `warp_tui` build.
#
# Unlike the GUI `./script/run`, the TUI is a console binary, so there is no
# `.app` bundle step — it just runs the `cargo` binary.
#
# Extra arguments are forwarded to `cargo run` (e.g. `--release`); use `--` to
# pass arguments through to the binary itself.

set -e

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
cd "${REPO_ROOT}"

echo "Running cargo run -p warp_tui --bin warp-tui-oss"
exec cargo run -p warp_tui --bin warp-tui-oss "$@"
