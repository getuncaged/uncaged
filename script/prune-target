#!/usr/bin/env bash
#
# Trims stale build output from `target/` so it doesn't slowly eat the disk.
#
# Removes:
#   * all but the newest incremental compilation cache of each crate (each
#     feature set or command gets its own cache, 1-3 GB for `uncaged`),
#   * `target/*/examples` (example binaries are never needed for normal work),
#   * stale duplicate rlibs/rmetas/dylibs and test executables in each
#     `target/*/deps`: when the same crate was built under several metadata
#     hashes, only the newest hash is kept.
#
# Usage: script/prune-target [--dry-run]

set -euo pipefail

DRY_RUN=0
[ "${1:-}" = "--dry-run" ] && DRY_RUN=1

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="${CARGO_TARGET_DIR:-$SCRIPT_DIR/../target}"

if [ ! -d "$TARGET_DIR" ]; then
  echo "No target directory at $TARGET_DIR; nothing to do."
  exit 0
fi

remove() {
  if [ "$DRY_RUN" = 1 ]; then
    echo "would remove $1"
  else
    rm -rf "$1"
  fi
}

# Every profile directory, both `target/<profile>` and `target/<triple>/<profile>`.
profile_dirs() {
  find "$TARGET_DIR" -mindepth 1 -maxdepth 2 -type d \( -name deps -o -name incremental -o -name examples \) -exec dirname {} \; | sort -u
}

before=$(du -sk "$TARGET_DIR" | cut -f1)

while IFS= read -r profile_dir; do
  # Incremental caches: one directory per crate+hash, e.g. `uncaged-1a2b3c`.
  # Every feature set or command (build, check, clippy, test) gets its own
  # 1-3 GB cache for `uncaged`, so keep only the newest one per crate.
  if [ -d "$profile_dir/incremental" ]; then
    python3 -I - "$profile_dir/incremental" "$DRY_RUN" <<'PY'
import collections, os, re, shutil, sys

inc, dry = sys.argv[1], sys.argv[2] == "1"
pat = re.compile(r"^(.+)-([0-9a-z]{10,16})$")
groups = collections.defaultdict(list)
for name in os.listdir(inc):
    path = os.path.join(inc, name)
    m = pat.match(name)
    if m and os.path.isdir(path):
        groups[m.group(1)].append(path)
for paths in groups.values():
    paths.sort(key=lambda p: os.lstat(p).st_mtime, reverse=True)
    for p in paths[1:]:
        if dry:
            print("would remove", p)
        else:
            shutil.rmtree(p, ignore_errors=True)
PY
  fi

  # Example binaries.
  if [ -d "$profile_dir/examples" ]; then
    remove "$profile_dir/examples"
  fi

  # Stale duplicates: group `deps/<name>-<hash>[.rlib|.rmeta|...]` (libraries
  # and test executables) by name and keep only the most recently written hash.
  if [ -d "$profile_dir/deps" ]; then
    python3 -I - "$profile_dir/deps" "$DRY_RUN" <<'PY'
import collections, os, re, shutil, sys

deps, dry = sys.argv[1], sys.argv[2] == "1"
# Libraries, plus test/bin executables (no extension) and their `.d` files.
pat = re.compile(r"^(.+?)-([0-9a-f]{16})(?:\.(rlib|rmeta|dylib|so|a|d))?$")
groups = collections.defaultdict(lambda: collections.defaultdict(list))
for name in os.listdir(deps):
    m = pat.match(name)
    if m and os.path.isfile(os.path.join(deps, name)):
        groups[(m.group(1), m.group(3))][m.group(2)].append(os.path.join(deps, name))
for hashes in groups.values():
    newest = max(hashes, key=lambda h: max(os.lstat(p).st_mtime for p in hashes[h]))
    for h, paths in hashes.items():
        if h == newest:
            continue
        for p in paths:
            if dry:
                print("would remove", p)
            else:
                try:
                    os.remove(p)
                except FileNotFoundError:
                    pass
PY
  fi
done < <(profile_dirs)

after=$(du -sk "$TARGET_DIR" | cut -f1)
echo "target/: $((before / 1024)) MB -> $((after / 1024)) MB"
