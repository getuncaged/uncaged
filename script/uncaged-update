#!/usr/bin/env bash
#
# uncaged-update — update Uncaged to the latest release, then relaunch it.
#
# This runs the same installer we publish on the site:
#
#     curl -fsSL https://getuncaged.dev/install.sh | bash
#
# Deliberately not a second, private update path. curl never sets
# com.apple.quarantine, so a bundle it writes opens without a Gatekeeper prompt --
# which matters a great deal for a fork with no Apple Developer ID, where a
# browser-downloaded copy is met with "unidentified developer" instead. Reusing
# the promoted installer also means the update path is the install path: one
# script to keep working, already exercised by everyone who installs.
#
# The app does not replace its own bundle. It spawns this and quits, so by the
# time anything is overwritten the process holding that bundle open is gone.
#
#     uncaged-update              # update if a newer release exists
#     uncaged-update --restart    # ...and wait for the app to exit first
#     uncaged-update --check      # report what would happen, change nothing
#
# Part of the Uncaged fork of the open-source Warp client. AGPL-3.0-only.

set -euo pipefail

REPO="getuncaged/uncaged"
API="https://api.github.com/repos/${REPO}/releases/latest"
INSTALLER_URL="https://getuncaged.dev/install.sh"
CASK_TOKEN="uncaged"
APP_PATH="/Applications/Uncaged.app"

RESTART=0
CHECK_ONLY=0
for arg in "$@"; do
  case "$arg" in
    --restart) RESTART=1 ;;
    --check)   CHECK_ONLY=1 ;;
    -h|--help) sed -n '3,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'unknown option: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
dim()  { printf '\033[2m%s\033[0m\n' "$1"; }
die()  { printf '\033[31m%s\033[0m\n' "$1" >&2; exit 1; }

command -v curl >/dev/null 2>&1 || die "curl is required"

installed_version() {
  [[ -f "$APP_PATH/Contents/Info.plist" ]] || return 1
  /usr/bin/plutil -extract WarpVersion raw "$APP_PATH/Contents/Info.plist" 2>/dev/null || return 1
}

LATEST_TAG="$(
  curl -fsSL -H 'Accept: application/vnd.github+json' "$API" \
    | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin).get("tag_name",""))'
)" || die "could not reach the GitHub releases API"
[[ -n "$LATEST_TAG" ]] || die "no tag_name in the latest release"

CURRENT="$(installed_version || echo "none")"

bold "Uncaged update"
dim  "  installed: ${CURRENT}"
dim  "  latest:    ${LATEST_TAG}"

# Dotted-integer compare, ignoring a leading v. Anything unparseable counts as
# "not newer" rather than being guessed at -- a wrong guess here downgrades someone.
is_newer() {
  /usr/bin/python3 - "${1#v}" "${2#v}" <<'PY'
import sys
def parse(v):
    try:
        return tuple(int(p) for p in v.split("."))
    except ValueError:
        return None
a, b = parse(sys.argv[1]), parse(sys.argv[2])
sys.exit(0 if a and b and a > b else 1)
PY
}

if [[ "$CURRENT" != "none" ]] && ! is_newer "$LATEST_TAG" "$CURRENT"; then
  bold "Already up to date."
  exit 0
fi

if (( CHECK_ONLY )); then
  bold "Update available: ${CURRENT} -> ${LATEST_TAG}"
  exit 0
fi

# The app spawns this and then quits. Overwriting the bundle while its process is
# still alive is what produces half-updated installs, so wait for it to go.
if (( RESTART )); then
  waited=0
  while pgrep -f "$APP_PATH/Contents/MacOS/" >/dev/null 2>&1 && (( waited < 30 )); do
    sleep 1; waited=$((waited + 1))
  done
fi

# A package manager that owns this install should be the one to update it.
# Replacing the bundle underneath Homebrew leaves its receipt naming a version
# that is no longer on disk: a later `brew upgrade` reinstalls over the top and
# `brew uninstall` removes something it no longer matches. Only when the running
# bundle is the cask's own -- a receipt proves brew installed *a* copy, not this one.
for prefix in /opt/homebrew /usr/local; do
  brew="$prefix/bin/brew"
  [[ -x "$brew" ]] || continue
  if "$brew" list --cask "$CASK_TOKEN" >/dev/null 2>&1 && [[ -d "$APP_PATH" ]]; then
    bold "Homebrew manages this install — upgrading the cask."
    dim  "  $brew upgrade --cask $CASK_TOKEN"
    "$brew" upgrade --cask "$CASK_TOKEN" || die "brew upgrade failed"
    bold "Updated to ${LATEST_TAG}."
    open -a "$APP_PATH" 2>/dev/null || true
    exit 0
  fi
  break
done

bold "Updating via the Uncaged installer..."
dim  "  curl -fsSL ${INSTALLER_URL} | bash"

# `bash` rather than `sh`: install.sh is the published entry point and is invoked
# that way everywhere we document it, so run it the same way here.
curl -fsSL "$INSTALLER_URL" | bash || die "installer failed"

# install.sh clears quarantine and opens the app itself, so there is nothing left
# to do -- doing it again here would open a second instance.
bold "Updated to ${LATEST_TAG}."
